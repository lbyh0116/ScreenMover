<Window x:Class="ScreenMover.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:ScreenMover.Views" Title="ScreenMover · 多屏窗口调度器">
<Window.SystemBackdrop><MicaBackdrop/></Window.SystemBackdrop>
<Grid x:Name="Root" Padding="24" RowSpacing="12">
<Grid.Resources><views:SelectionBrushConverter x:Key="SelectionBrush"/><DataTemplate x:Key="RowTemplate"><Border BorderBrush="{Binding Selected, Converter={StaticResource SelectionBrush}}" BorderThickness="2" CornerRadius="8"><Grid Padding="8,10" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="176"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⠿" Opacity=".5" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="3" Margin="0,0,12,0"><Border Background="#242424" CornerRadius="5" Width="160" Height="90"><Image Source="{Binding DisplayPreview}" MaxWidth="{Binding PreviewLimit}" MaxHeight="{Binding PreviewLimit}" Stretch="Uniform"/></Border><TextBlock Text="{Binding PreviewCaption}" FontSize="10" Opacity=".65" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Opacity=".65" FontFamily="Cascadia Mono, Microsoft YaHei UI"/></StackPanel></Grid></Border></DataTemplate><DataTemplate x:Key="GalleryTemplate"><Border BorderBrush="{Binding Selected, Converter={StaticResource SelectionBrush}}" BorderThickness="2" CornerRadius="8"><StackPanel Width="252" Padding="8" Spacing="6"><Border Background="#242424" CornerRadius="6" Height="118"><Image Source="{Binding DisplayPreview}" MaxWidth="{Binding PreviewLimit}" MaxHeight="{Binding PreviewLimit}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" MaxLines="2" TextWrapping="Wrap" FontSize="11" Opacity=".7"/><TextBlock Text="{Binding PreviewCaption}" FontSize="10" Opacity=".6" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate>
<ItemsPanelTemplate x:Key="RowsPanel"><ItemsStackPanel Orientation="Vertical"/></ItemsPanelTemplate>
<ItemsPanelTemplate x:Key="GalleryPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="272" ItemHeight="226"/></ItemsPanelTemplate>
</Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid RowSpacing="6" ColumnSpacing="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="ScreenMover" FontSize="28" FontWeight="SemiBold"/>
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="快捷面板" Click="QuickClicked"/><Button x:Name="HiddenButton" Content="已隐藏" Click="HiddenClicked"/><Button x:Name="SettingsButton" Content="设置" Click="SettingsClicked"/><Button Content="刷新 · F5" Click="RefreshClicked"/></StackPanel>
<TextBlock Grid.Row="1" Text="拖到屏幕可移动；拖到其他窗口前后可排序并保存。" TextTrimming="CharacterEllipsis" Opacity=".65"/>
<TextBlock Grid.Row="1" Grid.Column="1" x:Name="RefreshTime" HorizontalAlignment="Right" Opacity=".65"/>
</Grid><StackPanel Grid.Row="1" Spacing="6">
<TextBlock x:Name="MonitorHeading" Text="系统正在使用的显示器" FontWeight="SemiBold"/>
<GridView x:Name="MonitorTiles" SelectionMode="Single" SelectionChanged="MonitorSelectionChanged"
 ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
 ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
</GridView>
</StackPanel><StackPanel Grid.Row="2" Spacing="8">
<Grid><TextBlock x:Name="WindowHeading" Text="窗口" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SelectionHint" Text="Ctrl / Shift 多选 · 拖动排序 / 移屏" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity=".6"/></Grid>
<Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="SearchBox" PlaceholderText="搜索标题、软件名或 PID · Ctrl+F" TextChanged="SearchChanged" AutomationProperties.Name="搜索窗口"/>
<CheckBox x:Name="AllScreens" Grid.Column="1" Content="所有屏幕" Checked="ScopeChanged" Unchecked="ScopeChanged" VerticalAlignment="Center"/>
</Grid></StackPanel><Grid Grid.Row="3"><ListView x:Name="WindowsList" SelectionMode="Extended" SelectionChanged="WindowSelectionChanged" ItemTemplate="{StaticResource RowTemplate}"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle></ListView><TextBlock x:Name="EmptyState" Text="此屏幕上暂无可管理的窗口" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".6" IsHitTestVisible="False"/></Grid>
<StackPanel Grid.Row="4" Spacing="10"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="MoveButtons" Orientation="Horizontal" Spacing="8"/></ScrollViewer><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="MinButton" Content="最小化" Click="MinClicked" IsEnabled="False"/><Button x:Name="RestoreButton" Content="还原" Click="RestoreClicked" IsEnabled="False"/><Button x:Name="MaxButton" Content="最大化" Click="MaxClicked" IsEnabled="False"/><Button x:Name="UndoButton" Content="撤销移动" Click="UndoClicked" IsEnabled="False"/><Button x:Name="HideButton" Content="隐藏到新桌面" Click="HideClicked" IsEnabled="False"/></StackPanel></StackPanel>
<Grid Grid.Row="5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="SelectionStatus" FontSize="12" Opacity=".65"/><Grid MinHeight="32"><HyperlinkButton x:Name="HistoryButton" Content="操作记录" Click="HistoryClicked" Padding="0" HorizontalAlignment="Left"/><ScrollViewer x:Name="NoticePanel" Visibility="Collapsed" MaxHeight="60"><TextBlock x:Name="ResultStatus" Text="" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></Grid></StackPanel><HyperlinkButton x:Name="AdminButton" Grid.Column="1" Content="以管理员身份重启" Click="AdminClicked" VerticalAlignment="Bottom"/></Grid>
<Canvas x:Name="DragLayer" Grid.RowSpan="6" IsHitTestVisible="False"><Rectangle x:Name="InsertionMark" Visibility="Collapsed" Fill="{ThemeResource SystemControlHighlightAccentBrush}" IsHitTestVisible="False"/><Border x:Name="Ghost" Visibility="Collapsed" Opacity=".9" Background="#165DCC" CornerRadius="8" Padding="16,12"><TextBlock x:Name="GhostText" Foreground="White"/></Border></Canvas>
</Grid></Window>
