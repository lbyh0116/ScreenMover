<Window x:Class="ScreenMover.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:ScreenMover.Views" Title="ScreenMover · 多屏窗口调度器">

<Grid x:Name="Shell" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid x:Name="TitleDragRegion" Margin="12,0,140,0"><TextBlock Text="ScreenMover" FontSize="12" VerticalAlignment="Center"/></Grid>
<Grid Grid.Row="1" x:Name="Root" Background="Transparent" Padding="16" RowSpacing="12">
<Grid.Resources><DataTemplate x:Key="GalleryTemplate"><StackPanel Padding="10" Spacing="6"><Border Background="#242424" CornerRadius="6" Height="118"><Image Source="{Binding DisplayPreview}" MaxWidth="{Binding PreviewLimit}" MaxHeight="{Binding PreviewLimit}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity=".7" ToolTipService.ToolTip="{Binding Details}"/></StackPanel></DataTemplate>

<ItemsPanelTemplate x:Key="GalleryPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="272" ItemHeight="204"/></ItemsPanelTemplate>
</Grid.Resources><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid x:Name="HeadingGrid" RowSpacing="6" ColumnSpacing="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="ScreenMover" FontSize="28" FontWeight="SemiBold"/>
<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="快捷面板" Click="QuickClicked"/><Button x:Name="HiddenButton" Content="已隐藏" Click="HiddenClicked"/><Button x:Name="SettingsButton" Content="设置" Click="SettingsClicked"/><Button Content="刷新 · F5" Click="RefreshClicked"/></StackPanel>

<TextBlock Grid.Row="1" Grid.Column="1" x:Name="RefreshTime" Visibility="Collapsed"/>
</Grid><StackPanel x:Name="MonitorRegion" Grid.Row="1" Spacing="6">
<TextBlock x:Name="MonitorHeading" Text="系统正在使用的显示器" FontWeight="SemiBold"/>
<GridView x:Name="MonitorTiles" SelectionMode="Single" SelectionChanged="MonitorSelectionChanged" ItemContainerStyle="{StaticResource MonitorItemStyle}"
 ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
 ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
<GridView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
</GridView>
</StackPanel><StackPanel Grid.Row="2" Spacing="8">
<Grid><TextBlock x:Name="WindowHeading" Text="窗口" FontSize="20" FontWeight="SemiBold"/></Grid>
<Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="SearchBox" PlaceholderText="搜索窗口" TextChanged="SearchChanged" AutomationProperties.Name="搜索窗口"/>
<CheckBox x:Name="AllScreens" Grid.Column="1" Content="所有屏幕" Checked="ScopeChanged" Unchecked="ScopeChanged" VerticalAlignment="Center"/>
</Grid></StackPanel><Grid Grid.Row="3"><ListView x:Name="WindowsList" ItemContainerStyle="{StaticResource WindowItemStyle}" SizeChanged="WindowListSizeChanged" SelectionMode="Extended" SelectionChanged="WindowSelectionChanged" ItemTemplate="{StaticResource GalleryTemplate}" ItemsPanel="{StaticResource GalleryPanel}"><ListView.ItemContainerTransitions><TransitionCollection><AddDeleteThemeTransition/><ReorderThemeTransition/><RepositionThemeTransition/></TransitionCollection></ListView.ItemContainerTransitions></ListView><TextBlock x:Name="EmptyState" Text="此屏幕上暂无可管理的窗口" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".6" IsHitTestVisible="False"/></Grid>
<StackPanel Grid.Row="4" Spacing="10"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="MoveButtons" Orientation="Horizontal" Spacing="8"/></ScrollViewer><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="MinButton" Content="最小化" Click="MinClicked" IsEnabled="False"/><Button x:Name="RestoreButton" Content="还原" Click="RestoreClicked" IsEnabled="False"/><Button x:Name="MaxButton" Content="最大化" Click="MaxClicked" IsEnabled="False"/><Button x:Name="UndoButton" Content="撤销移动" Click="UndoClicked" IsEnabled="False"/><Button x:Name="HideButton" Content="隐藏到新桌面" Click="HideClicked" IsEnabled="False"/></StackPanel></StackPanel>
<Grid Grid.Row="5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock x:Name="SelectionStatus" FontSize="12" Opacity=".65"/><Grid MinHeight="32"><HyperlinkButton x:Name="HistoryButton" Content="操作记录" Click="HistoryClicked" Padding="0" HorizontalAlignment="Left"/><ScrollViewer x:Name="NoticePanel" Visibility="Collapsed" MaxHeight="60"><TextBlock x:Name="ResultStatus" Text="" TextWrapping="Wrap" FontSize="12"/></ScrollViewer></Grid></StackPanel><HyperlinkButton x:Name="AdminButton" Grid.Column="1" Content="以管理员身份重启" Click="AdminClicked" VerticalAlignment="Bottom"/></Grid>
<Canvas x:Name="DragLayer" Grid.RowSpan="6" IsHitTestVisible="False"><Rectangle x:Name="InsertionMark" Visibility="Collapsed" Fill="{ThemeResource AppAccentBrush}" IsHitTestVisible="False"/><Border x:Name="Ghost" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="0"><Grid><StackPanel Spacing="4"><Image x:Name="GhostImage" Stretch="Uniform"/><TextBlock x:Name="GhostText" Visibility="Collapsed"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,1" Background="{ThemeResource AppAccentBrush}" CornerRadius="4"><TextBlock x:Name="GhostCount" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/></Border></Grid></Border></Canvas>
</Grid><Grid Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" Padding="24,12,24,24" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="16"><Button x:Name="SettingsBack" Style="{StaticResource SubtleButtonStyle}" Click="SettingsBackClicked" ToolTipService.ToolTip="返回" AutomationProperties.Name="返回主界面"><FontIcon Glyph="&#xE72B;" FontSize="16"/></Button><TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="SettingsState" FontSize="12" MaxWidth="420" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity=".75"/></StackPanel><ScrollViewer x:Name="SettingsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"/></Grid></Grid></Window>
