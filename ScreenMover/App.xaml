<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ScreenMover.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenMover" xmlns:views="using:ScreenMover.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SurfaceNormal" TargetType="views:SelectionSurface">
                <Setter Property="IsTabStop" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="CornerRadius" Value="8"/><Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:SelectionSurface"><Grid>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </Border>
                    <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity=".36"/>
                        <Border VerticalAlignment="Center" HorizontalAlignment="Center" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,7" Margin="8"><TextBlock Text="{TemplateBinding DropLabel}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold"/></Border>
                    </Grid>
                </Grid></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SurfaceHover" TargetType="views:SelectionSurface" BasedOn="{StaticResource SurfaceNormal}">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="SurfaceSelected" TargetType="views:SelectionSurface" BasedOn="{StaticResource SurfaceNormal}">
                <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
            </Style>
            <Style x:Key="WindowItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/>
                <Setter Property="CornerRadius" Value="8"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
                    <views:SelectionSurface IsSelected="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                    </views:SelectionSurface>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="MonitorItemStyle" TargetType="GridViewItem">
                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/><Setter Property="CornerRadius" Value="8"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem">
                    <views:SelectionSurface IsSelected="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </views:SelectionSurface>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
